MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=174379
MPESA_CALLBACK_URL=https://your-tunnel.example/callback
MPESA_AMOUNT_CAP=10000
MPESA_API_KEY=choose-a-long-random-string
MPESA_DB_PATH=data/daraja.sqlite
MPESA_QUERY_AFTER_MS=30000
PORT=5001

# Required for B2C, reversal, and account balance. The credential is the
# encrypted initiator password from the Daraja portal, not the plain password.
MPESA_INITIATOR_NAME=
MPESA_SECURITY_CREDENTIAL=
MPESA_B2C_RESULT_URL=https://your-tunnel.example/b2c/result
MPESA_B2C_TIMEOUT_URL=https://your-tunnel.example/b2c/timeout
MPESA_REVERSAL_RESULT_URL=https://your-tunnel.example/reversal/result
MPESA_REVERSAL_TIMEOUT_URL=https://your-tunnel.example/reversal/timeout
MPESA_BALANCE_RESULT_URL=https://your-tunnel.example/balance/result
MPESA_BALANCE_TIMEOUT_URL=https://your-tunnel.example/balance/timeout
MPESA_C2B_VALIDATION_URL=https://your-tunnel.example/c2b/validation
MPESA_C2B_CONFIRMATION_URL=https://your-tunnel.example/c2b/confirmation

# Optional till number for examples/till.ts. Sandbox can use the test shortcode.
MPESA_TILL=174379

# Optional. SMS receipts and nothing else. Leave blank to skip Africa's Talking.
AT_ENV=sandbox
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=

# Optional. Without these, the agent uses the built-in planner.
AGENT_API_KEY=
AGENT_BASE_URL=https://api.openai.com/v1
AGENT_MODEL=gpt-4o-mini
