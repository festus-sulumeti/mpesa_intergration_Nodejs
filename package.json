{
  "name": "mpesa-daraja",
  "version": "1.0.0",
  "description": "Typed Safaricom Daraja client, STK reference server, and a confirmation-gated payments agent",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/festus-sulumeti/mpesa_intergration_Nodejs.git"
  },
  "scripts": {
    "test": "tsx --test test/**/*.test.ts",
    "build": "tsc",
    "prepublishOnly": "pnpm run build",
    "start": "tsx watch src/server.ts",
    "serve": "node dist/server.js",
    "agent": "tsx src/agent/cli.ts",
    "mcp": "tsx src/mcp/server.ts",
    "example:chama": "tsx examples/chama.ts",
    "example:school": "tsx examples/school-fees.ts",
    "example:till": "tsx examples/till.ts",
    "example:subscription": "tsx examples/subscription.ts"
  },
  "keywords": ["mpesa", "daraja", "kenya", "stk", "lipa-na-mpesa"],
  "author": "Festus Sulumeti",
  "license": "ISC",
  "packageManager": "pnpm@12.5.1",
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
